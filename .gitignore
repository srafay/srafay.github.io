# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent notes (kept local)
AGENTS.md
CLAUDE.md

# cosmos
/cosmos/

# drafts
/drafts/

# the site's menu, built from lib/site-menu/ by scripts/build-site-menu.ts
/public/site-menu.js

# the About page's script and its versions' scene scripts, built by scripts/build-about-scenes.ts
/public/about*.js
# version 4 of the About page, a page of its own, built whole by scripts/build-world-lines-page.ts
/public/about/v4/
# version 5 of the About page, built whole by scripts/build-hypercube-page.ts
/public/about/v5/
# version 6 of the About page, built whole by scripts/build-guide-page.ts
/public/about/v6/
# version 7 of the About page, built whole by scripts/build-letters-page.ts
/public/about/v7/
